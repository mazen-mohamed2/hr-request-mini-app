NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://hr_dev:hr_dev_password@localhost:55432/hr_requests?schema=public
TEST_DATABASE_URL=postgresql://hr_test:hr_test_password@localhost:55433/hr_requests_test?schema=public
# Generate a local secret: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=3600
# Comma-separated exact browser origins; native mobile clients need no CORS origin.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=info
LOGIN_RATE_LIMIT_MAX=10
